  {
    "id": "mingle",
    "name": "Mingle",
    "year": "2026",
    "status": "Final testing",
    "subtitle": "Interactive platform for events",
    "description": "An interactive platform for events of any kind, from parties to corporate nights. Guests join through a QR code with no app to install, and the hosts control every moment of the night from one dashboard. Everything is built; only the LED wristbands are left to test at a real event.",
    "features": [
      "Pulse: an LED wristband on every guest that lights up the room to the beat of the music and reacts to the activities",
      "Roll: each guest's phone becomes a film camera, photos show live on the TV and are revealed together at the end",
      "Cheers: guests leave a written or recorded message with a photo, kept in a book for the hosts",
      "Jukebox: guests request songs from their phone and the DJ sees the list on a screen",
      "Buzz: a live quiz, with the question on the TV, answers on the phone and a podium"
    ],
    "technologies": ["React", "TypeScript", "Firebase", "Node.js", "Python", "Vercel"],
    "logo": "mingle",
